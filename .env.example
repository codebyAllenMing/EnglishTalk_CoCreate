# 複製成 .env.local 後填值（.env.local 已 gitignore，secret 一律不進 repo）。
#   cp .env.example .env.local
# dev 全在 localhost：前端 6531、api 4000、Postgres 5432、Mailpit 8025。

# Postgres（對應 docker-compose.yml；prod 換成 Neon 的連線字串）
DATABASE_URL=postgresql://monstertalk:monstertalk@localhost:5432/monstertalk

# API
API_PORT=4000
API_ORIGIN=http://localhost:4000
# 允許帶 cookie 打 API 的前端 origin（CORS 與 better-auth trustedOrigins 共用）
WEB_ORIGIN=http://localhost:6531

# better-auth 簽 session / cookie 用的金鑰，dev 與 prod 必須不同：
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# Mailpit（密碼重設 / email 驗證尚未接線，先留著）
SMTP_HOST=localhost
SMTP_PORT=1025
