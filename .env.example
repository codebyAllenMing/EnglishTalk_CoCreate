# 複製成 .env.local 後填值（.env.local 已 gitignore，secret 一律不進 repo）。
#   cp .env.example .env.local
# dev 全在 localhost、一律 https：前端 6531、api 4000、Postgres 5432、Mailpit 8025。

# Postgres（對應 docker-compose.yml；prod 換成 Neon 的連線字串）
DATABASE_URL=postgresql://monstertalk:monstertalk@localhost:5432/monstertalk

# API
API_PORT=4000
API_ORIGIN=https://localhost:4000
# 允許帶 cookie 打 API 的前端 origin（CORS、better-auth trustedOrigins、WS 握手共用）；逗號分隔可多個
WEB_ORIGIN=https://localhost:6531,https://talk.allenmingstudio.com

# dev 一律 https。憑證是前端 `next dev --experimental-https` 用 mkcert 產的（第一次跑會要密碼裝本機 CA），
# api 共用同一份；路徑相對 repo 根目錄。兩個都留空就退回 http。
# 手機測試：前端改用 `next dev -H <區網IP> --experimental-https` 讓憑證含那個 IP，WEB_ORIGIN 用逗號多列一個 https://<區網IP>:6531，
# 手機要先裝 mkcert 的根憑證（`mkcert -CAROOT` 底下的 rootCA.pem）。
TLS_CERT=apps/web/certificates/localhost.pem
TLS_KEY=apps/web/certificates/localhost-key.pem

# better-auth 簽 session / cookie 用的金鑰，dev 與 prod 必須不同：
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# Mailpit（密碼重設 / email 驗證尚未接線，先留著）
SMTP_HOST=localhost
SMTP_PORT=1025

# 白板：tldraw 的授權金鑰**不放這裡**，放 apps/web/.env.local（Next 只讀自己目錄的 env，build 時內嵌進 bundle）：
#   NEXT_PUBLIC_TLDRAW_LICENSE_KEY=<tldraw.dev 的 hobby license，綁 talk.allenmingstudio.com>
# dev（localhost）不需要；正式網域沒金鑰白板會在 5 秒後消失。

# 視訊：Cloudflare Realtime Serverless SFU（儀表板 Realtime → Serverless SFU → Create；免費 1,000GB/月）。
# 沒填視訊路由回 503、房間其他功能照常。Secret 只在 server，prod 放 Workers secret。
CF_REALTIME_APP_ID=
CF_REALTIME_APP_SECRET=
